def build_extension_index(families: Any) -> Any:
    index: Any = {}
    for family in families:
        for ext in family["extensions"]:
            key: Str = ext.lower()
            if key not in index:
                index[key] = []
            if family["id"] not in index[key]:
                index[key].append(family["id"])
    return index

def build_alias_index(families: Any) -> Any:
    index: Any = {}
    for family in families:
        index[family["id"]] = family["id"]
        for alias in family["aliases"]:
            index[alias.lower()] = family["id"]
    return index

def build_database() -> Any:
    db: Any = {}
    db["schema_version"] = SCHEMA_VERSION
    db["name"] = "Talus Ransomware Knowledge Base"
    db["updated"] = UPDATED
    db["license"] = "MIT"
    db["sources"] = SOURCES
    db["stats"] = {
        "family_count": len(FAMILIES),
        "extension_count": len(build_extension_index(FAMILIES)),
        "families_with_extensions": len([f for f in FAMILIES if len(f["extensions"]) > 0])
    }
    db["extension_index"] = build_extension_index(FAMILIES)
    db["alias_index"] = build_alias_index(FAMILIES)
    db["families"] = FAMILIES
    return db

def build_note_index(families: Any) -> Any:
    # Generic names are excluded: they are far too common in legitimate
    # projects to be useful evidence. Distinctive family notes stay.
    generic: Any = {"readme.txt": True, "info.txt": True, "info.hta": True, "ransom.html": True}
    index: Any = {}
    for family in families:
        for note in family["ransom_notes"]:
            key: Str = note.lower()
            if key not in generic:
                index[key] = True
    return index

def export_mode() -> Str:
    return os.environ.get("TALUS_EXPORT", "json")

if export_mode() == "markers":
    # Runtime artifact: sorted, one extension per line, no metadata. Talus
    # binary-searches this list, so the binary carries only detection-critical
    # data and needs no JSON parser.
    for ext in sorted(build_extension_index(FAMILIES).keys()):
        print(ext)
elif export_mode() == "notes":
    # High-confidence ransom-note basenames, lowercased and sorted.
    for note in sorted(build_note_index(FAMILIES).keys()):
        print(note)
else:
    print(json.dumps(build_database(), indent=2, sort_keys=True))
