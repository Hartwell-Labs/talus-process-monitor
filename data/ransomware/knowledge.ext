# Talus ransomware knowledge base.
#
# This file is the canonical source. Talus embeds the generated JSON so the
# agent does not need an Externum runtime at deployment time:
#
#   externum run knowledge.ext > knowledge.json
#
# Keep uncertain fields empty rather than guessing. A missing extension is
# better than a marker that turns a legitimate backup into an alert.

import json
import os

